# Add these directives inside the existing zachbednarke.com site block,
# before its file_server directive. Do not commit a plaintext password.
#
# To use the same login as portal.zachbednarke.com, replace the environment
# placeholders with the existing username and password hash from that site's
# basic_auth block. Caddy accepts password hashes only, never plaintext.

# If the parent site has a site-wide Permissions-Policy that disables the
# microphone, scope that policy away from Jazz. Two header directives that set
# the same field can leave the restrictive value on the Jazz response.
# The live-effects tool is embedded from this same origin, so a site-wide
# X-Frame-Options policy must be SAMEORIGIN rather than DENY.
@not_jazz {
    not path /jazz /jazz/* /assets/jazz/*
}

header @not_jazz Permissions-Policy "camera=(), microphone=(), geolocation=()"

@jazz_private {
    path /jazz /jazz/* /assets/jazz/*
    not path /jazz/share/*
}

basic_auth @jazz_private bcrypt restricted {
    {$JAZZ_AUTH_USER} {$JAZZ_AUTH_HASH}
}

header @jazz_private {
    X-Robots-Tag "noindex, nofollow, noarchive"
    Cache-Control "private, no-store"
    Referrer-Policy "no-referrer"
    # The page has no third-party frames; Chrome still requires site permission.
    Permissions-Policy "camera=*, microphone=*, geolocation=()"
}

# Keep this block before the site's file_server. Caddy strips /jazz/api,
# forwards the authenticated username, and adds a gateway secret that is never
# exposed to browser JavaScript. Set JAZZ_API_URL and JAZZ_GATEWAY_KEY in the
# Caddy service environment, not in this repository.
handle_path /jazz/api/* {
    reverse_proxy {$JAZZ_API_URL} {
        header_up Host {upstream_hostport}
        header_up X-Jazz-User {http.auth.user.id}
        header_up X-Jazz-Gateway-Key {$JAZZ_GATEWAY_KEY}
    }
}

# Permanent opaque share links are deliberately outside Basic Auth. The API
# validates the bearer token and redirects each request to a fresh short-lived
# private-storage URL; the recording bucket itself remains private.
handle_path /jazz/share/* {
    rewrite * /v1/public/recordings{http.request.uri.path}
    reverse_proxy {$JAZZ_API_URL} {
        header_up Host {upstream_hostport}
    }
}
